NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://ledger:ledger@localhost:5544/ledger
# Comma-separated SHA-256 hex digests of accepted API keys.
# Generate one with: printf 'my-secret-key' | sha256sum
# Append :read to a digest to make that key read-only.
API_KEY_HASHES=
RATE_LIMIT_MAX=300
LOG_LEVEL=info
HOLD_EXPIRY_SWEEP_SECONDS=30
