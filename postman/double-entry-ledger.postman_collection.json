{
  "info": {
    "_postman_id": "32ab4972-368c-5872-a57a-9b69e0770ab5",
    "name": "Double-Entry Ledger API",
    "description": "A guided tour of the ledger API that also runs as an end-to-end test.\n\nRun the folders in order, or run the whole collection. Each run uses fresh account codes and references, so it can be repeated against the same database.\n\n**Setup:** start the service with `make up`. The default variables point at `http://localhost:3000` with the local API key `dev-key`.\n\n**Amounts** are whole numbers of minor units, as strings: `\"5000\"` is 50.00.\n\n**Idempotency:** a pre-request script sets a fresh `Idempotency-Key` for every request. The retry examples reuse a saved key on purpose.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key"
      },
      {
        "key": "value",
        "value": "{{apiKey}}"
      },
      {
        "key": "in",
        "value": "header"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// One id per run keeps account codes and references unique, so the",
          "// collection can be run again and again against the same database.",
          "if (!pm.collectionVariables.get('runId')) {",
          "  pm.collectionVariables.set('runId', Date.now().toString(36) + Math.random().toString(36).slice(2, 6));",
          "}",
          "// A fresh idempotency key for every request.",
          "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('returns a request id', () => pm.expect(pm.response.headers.get('X-Request-Id')).to.be.a('string'));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "apiKey",
      "value": "dev-key"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "idempotencyKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Accounts",
      "description": "Create the accounts the rest of the tour uses.",
      "item": [
        {
          "name": "Create the bank's cash account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "accounts"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"bank:cash-{{runId}}\",\n  \"name\": \"Cash at bank\",\n  \"type\": \"asset\",\n  \"currency\": \"USD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "An asset account: the money the business actually holds at its bank."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('starts at zero', () => pm.expect(pm.response.json().balance).to.eql('0'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a customer wallet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "accounts"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"wallet:alice-{{runId}}\",\n  \"name\": \"Alice\",\n  \"type\": \"liability\",\n  \"currency\": \"USD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "A liability account: money the business owes to a customer. It cannot go below zero."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status is 201', () => pm.response.to.have.status(201));"]
              }
            }
          ]
        },
        {
          "name": "Create a merchant account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "accounts"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"merchant:shop-{{runId}}\",\n  \"name\": \"Shop\",\n  \"type\": \"liability\",\n  \"currency\": \"USD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status is 201', () => pm.response.to.have.status(201));"]
              }
            }
          ]
        },
        {
          "name": "Reject a duplicate account code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "accounts"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"wallet:alice-{{runId}}\",\n  \"name\": \"Alice again\",\n  \"type\": \"liability\",\n  \"currency\": \"USD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('code is account_exists', () => pm.expect(pm.response.json().error.code).to.eql('account_exists'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject an invalid account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "accounts"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"Not A Valid Code\",\n  \"name\": \"\",\n  \"type\": \"savings\",\n  \"currency\": \"usd\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('lists the failing fields', () => pm.expect(pm.response.json().error.details.issues.length).to.be.above(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get an account",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/accounts/wallet:alice-{{runId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "accounts", "wallet:alice-{{runId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('has balances', () => pm.expect(pm.response.json()).to.include.keys('balance', 'availableBalance', 'held'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List accounts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/accounts?limit=50&type=liability",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "accounts"],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "type",
                  "value": "liability"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns a page', () => pm.expect(pm.response.json().accounts).to.be.an('array'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Transactions",
      "description": "Post, retry safely, and reverse.",
      "item": [
        {
          "name": "Deposit 50.00 into the wallet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "transactions"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference\": \"deposit-{{runId}}\",\n  \"description\": \"Card deposit\",\n  \"entries\": [\n    {\n      \"accountCode\": \"bank:cash-{{runId}}\",\n      \"direction\": \"debit\",\n      \"amount\": \"5000\"\n    },\n    {\n      \"accountCode\": \"wallet:alice-{{runId}}\",\n      \"direction\": \"credit\",\n      \"amount\": \"5000\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Debits the bank's cash and credits the customer's wallet. Both sides are recorded or neither is."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('depositId', body.id);",
                  "pm.collectionVariables.set('depositKey', pm.request.headers.get('Idempotency-Key'));",
                  "pm.test('has two entries', () => pm.expect(body.entries).to.have.lengthOf(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "Retry the deposit with the same key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{depositKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "transactions"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference\": \"deposit-{{runId}}\",\n  \"description\": \"Card deposit\",\n  \"entries\": [\n    {\n      \"accountCode\": \"bank:cash-{{runId}}\",\n      \"direction\": \"debit\",\n      \"amount\": \"5000\"\n    },\n    {\n      \"accountCode\": \"wallet:alice-{{runId}}\",\n      \"direction\": \"credit\",\n      \"amount\": \"5000\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "What a client does after a timeout. The ledger returns the first response and posts nothing new."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('is marked as a replay', () => pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.eql('true'));",
                  "pm.test('returns the original transaction', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('depositId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reuse the key for a different request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{depositKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "transactions"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference\": \"something-else-{{runId}}\",\n  \"description\": \"Card deposit\",\n  \"entries\": [\n    {\n      \"accountCode\": \"bank:cash-{{runId}}\",\n      \"direction\": \"debit\",\n      \"amount\": \"5000\"\n    },\n    {\n      \"accountCode\": \"wallet:alice-{{runId}}\",\n      \"direction\": \"credit\",\n      \"amount\": \"5000\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 422', () => pm.response.to.have.status(422));",
                  "pm.test('code is idempotency_key_reused', () => pm.expect(pm.response.json().error.code).to.eql('idempotency_key_reused'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Wallet balance is 50.00, not 100.00",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/accounts/wallet:alice-{{runId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "accounts", "wallet:alice-{{runId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('the retry did not double the deposit', () => pm.expect(pm.response.json().balance).to.eql('5000'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Pay the merchant 20.00",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "transactions"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference\": \"payment-{{runId}}\",\n  \"entries\": [\n    {\n      \"accountCode\": \"wallet:alice-{{runId}}\",\n      \"direction\": \"debit\",\n      \"amount\": \"2000\"\n    },\n    {\n      \"accountCode\": \"merchant:shop-{{runId}}\",\n      \"direction\": \"credit\",\n      \"amount\": \"2000\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('paymentId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject an unbalanced transaction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "transactions"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference\": \"unbalanced-{{runId}}\",\n  \"entries\": [\n    {\n      \"accountCode\": \"wallet:alice-{{runId}}\",\n      \"direction\": \"debit\",\n      \"amount\": \"100\"\n    },\n    {\n      \"accountCode\": \"merchant:shop-{{runId}}\",\n      \"direction\": \"credit\",\n      \"amount\": \"90\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 422', () => pm.response.to.have.status(422));",
                  "pm.test('code is unbalanced_transaction', () => pm.expect(pm.response.json().error.code).to.eql('unbalanced_transaction'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject an overdraft",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "transactions"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference\": \"overdraft-{{runId}}\",\n  \"entries\": [\n    {\n      \"accountCode\": \"wallet:alice-{{runId}}\",\n      \"direction\": \"debit\",\n      \"amount\": \"999999\"\n    },\n    {\n      \"accountCode\": \"merchant:shop-{{runId}}\",\n      \"direction\": \"credit\",\n      \"amount\": \"999999\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 422', () => pm.response.to.have.status(422));",
                  "pm.test('code is insufficient_funds', () => pm.expect(pm.response.json().error.code).to.eql('insufficient_funds'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Require an Idempotency-Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "transactions"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference\": \"deposit-{{runId}}\",\n  \"description\": \"Card deposit\",\n  \"entries\": [\n    {\n      \"accountCode\": \"bank:cash-{{runId}}\",\n      \"direction\": \"debit\",\n      \"amount\": \"5000\"\n    },\n    {\n      \"accountCode\": \"wallet:alice-{{runId}}\",\n      \"direction\": \"credit\",\n      \"amount\": \"5000\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('code is idempotency_key_required', () => pm.expect(pm.response.json().error.code).to.eql('idempotency_key_required'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get a transaction",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/transactions/{{paymentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "transactions", "{{paymentId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('is the payment', () => pm.expect(pm.response.json().reference).to.match(/^payment-/));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refund the payment (reverse it)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/transactions/{{paymentId}}/reversals",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "transactions", "{{paymentId}}", "reversals"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Customer refund\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Posts the mirror image of the payment. The original transaction is never edited."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('points at the original', () => pm.expect(pm.response.json().reverses).to.eql(pm.collectionVariables.get('paymentId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject a second reversal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/transactions/{{paymentId}}/reversals",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "transactions", "{{paymentId}}", "reversals"]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('code is already_reversed', () => pm.expect(pm.response.json().error.code).to.eql('already_reversed'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Holds",
      "description": "Authorize now, capture or void later.",
      "item": [
        {
          "name": "Authorize 15.00 on the wallet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
