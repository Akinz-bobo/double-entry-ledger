                  "pm.test('newest first', () => pm.expect(pm.response.json().entries[0].reference).to.match(/^capture:/));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reconcile cash against a bank statement",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/reconciliations",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "reconciliations"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountCode\": \"bank:cash-{{runId}}\",\n  \"from\": \"{{periodStart}}\",\n  \"to\": \"{{periodEnd}}\",\n  \"statement\": [\n    {\n      \"reference\": \"deposit-{{runId}}\",\n      \"direction\": \"debit\",\n      \"amount\": \"4900\"\n    },\n    {\n      \"reference\": \"unknown-{{runId}}\",\n      \"direction\": \"debit\",\n      \"amount\": \"700\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "The statement disagrees with the ledger on purpose: one amount is wrong and one line was never posted."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('periodStart', new Date(Date.now() - 3600000).toISOString());",
                  "pm.collectionVariables.set('periodEnd', new Date(Date.now() + 3600000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const report = pm.response.json();",
                  "pm.test('is not balanced', () => pm.expect(report.balanced).to.be.false);",
                  "pm.test('finds the amount mismatch', () => pm.expect(report.amountMismatches).to.have.lengthOf(1));",
                  "pm.test('finds the payment missing from the ledger', () => pm.expect(report.missingInLedger).to.have.lengthOf(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Trial balance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/reports/trial-balance",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "reports", "trial-balance"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('the books balance', () => pm.expect(pm.response.json().balanced).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Read the event feed",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/events?limit=100",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "events"],
              "query": [
                {
                  "key": "limit",
                  "value": "100"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.collectionVariables.set('eventCursor', page.nextCursor);",
                  "pm.test('has events', () => pm.expect(page.events.length).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Poll the feed from the cursor",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/events?cursor={{eventCursor}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "events"],
              "query": [
                {
                  "key": "cursor",
                  "value": "{{eventCursor}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns a cursor to keep polling from', () => pm.expect(pm.response.json().nextCursor).to.be.a('string'));"
                ]
              }
            }
          ]
        }
      ]
